            }
          }
        },
        {
          "name": "GET /projects",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/projects?limit=20&offset=0"
          }
        },
        {
          "name": "GET /projects/{projectId}",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}"
          }
        },
        {
          "name": "PATCH /projects/{projectId}",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"ARCHIVED\"\n}" }
          }
        },
        {
          "name": "DELETE /projects/{projectId}",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}"
