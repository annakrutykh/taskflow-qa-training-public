        },
        {
          "name": "DELETE /projects/{projectId}/members/{userId}",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/members/{{userId}}"
          }
        }
      ]
