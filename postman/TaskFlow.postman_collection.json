              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/members",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"role\": \"MANAGER\"\n}"
            }
          }
        },
        {
          "name": "GET /projects/{projectId}/members",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/members"
          }
        },
        {
          "name": "PATCH /projects/{projectId}/members/{userId}",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/members/{{userId}}",
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"VIEWER\"\n}" }
