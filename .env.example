# Скопируйте этот файл в .env (docker compose подхватывает .env автоматически,
# сам файл .env в git не попадает — см. .gitignore).
#
# TRAINING_DEFECTS не устанавливайте самостоятельно — это внутренний параметр
# преподавателя для управления учебными сценариями. Если для вашего задания
# нужно конкретное значение, преподаватель выдаст его отдельно.
TRAINING_DEFECTS=
