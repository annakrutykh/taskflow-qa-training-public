# Скопируйте этот файл в .env (docker compose подхватывает .env автоматически,
# сам файл .env в git не попадает — см. .gitignore).
#
# TRAINING_DEFECTS не меняйте самостоятельно — это внутренний параметр
# преподавателя для управления учебными сценариями. Значение по умолчанию
# уже включает нужный для курса набор.
TRAINING_DEFECTS=D-01,D-02,D-04,D-17
